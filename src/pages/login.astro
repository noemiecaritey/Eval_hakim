---
import { SignIn } from 'auth-astro/components';
---

<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Connexion | Clients</title>
  <style>
    body {
      margin: 0;
      min-height: 100vh;
      display: grid;
      place-items: center;
      background: #f5f7fb;
      font-family: ui-sans-serif, system-ui, sans-serif;
    }
    .card {
      background: white;
      padding: 32px;
      border-radius: 18px;
      border: 1px solid #e7ebf2;
      box-shadow: 0 8px 30px rgba(15, 23, 42, 0.07);
      width: 100%;
      max-width: 360px;
      text-align: center;
    }
    h1 { margin: 0 0 24px; font-size: 24px; }
    .btn {
      width: 100%;
      padding: 12px 16px;
      border: none;
      border-radius: 10px;
      background: #4f46e5;
      color: white;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
    }
    .btn:hover { background: #4338ca; }
  </style>
</head>
<body>
  <div class="card">
    <h1>Connexion</h1>
    <SignIn provider="google" class="btn">
      Se connecter avec Google
    </SignIn>
  </div>
</body>
</html>